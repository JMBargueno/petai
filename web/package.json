{
  "name": "pockai-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "sync-assets": "node scripts/sync-assets.mjs",
    "start": "node scripts/sync-assets.mjs && ng serve",
    "build": "node scripts/sync-assets.mjs && ng build && node scripts/postbuild.mjs",
    "test": "ng test --watch=false",
    "extract-i18n": "ng extract-i18n --format json --output-path src/locale --out-file messages.es.json",
    "preview": "node scripts/preview.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Pockai — landing oficial y panel de administración (mock)"
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pockai",
  "version": "0.22.0",
  "identifier": "com.petai.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pockai",
        "width": 1024,
        "height": 768,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://game-api.pockai.world",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://game-api.pockai.world wss://game-api.pockai.world",
        "media-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://localhost:5173 http://127.0.0.1:3000",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://127.0.0.1:3000 ws://127.0.0.1:3000",
        "media-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Pockai",
    "copyright": "© 2026 Pockai",
    "category": "Game",
    "shortDescription": "Tu mascota virtual inteligente",
    "longDescription": "Pockai: mascota virtual con IA que vive en tu escritorio.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "headerImage": "icons/installer/header.bmp",
        "uninstallerHeaderImage": "icons/installer/header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMEUyNDA3Q0M4MTVCNkUKUldSdVc0SE1CeVFPY0RHVGR0eVZBbVBaK0FzSVVSQ0JnTm9GUnp4bjdCQUZkNk40Z3g5bVZSVDgK",
      "endpoints": [
        "https://game-api.pockai.world/v1/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

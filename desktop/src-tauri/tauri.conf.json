{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetAI",
  "version": "0.1.0",
  "identifier": "com.petai.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PetAI",
        "width": 1024,
        "height": 768,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "PetAI",
    "copyright": "© 2026 PetAI",
    "category": "Game",
    "shortDescription": "Tu mascota virtual inteligente",
    "longDescription": "PetAI: mascota virtual con IA que vive en tu escritorio.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}

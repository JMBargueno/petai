{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana de Pockai en escritorio",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "autostart:default",
    "pockai:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "https://*/**"
        }
      ]
    }
  ]
}

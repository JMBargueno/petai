{
  "name": "petai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PetAI — Mascota virtual tamagotchi inteligente multiplataforma",
  "scripts": {
    "validate:data": "node scripts/validate-game-data.js",
    "generate:api": "openapi-typescript shared/openapi/openapi.json -o shared/openapi/api-types.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "backend:dev": "pnpm --filter backend run start:dev",
    "backend:test": "pnpm --filter backend run test",
    "backend:build": "pnpm --filter backend run build"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}

{
  "uid": "petai-cdn-region",
  "title": "PetAI — CDN por región",
  "tags": ["petai", "cdn", "feature-009"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CDN hits por región (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (region) (rate(petai_cdn_hit_total[5m]))",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fallback a origin por región (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (region) (rate(petai_cdn_fallback_origin_total[5m]))",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95 del refresh (ms) por región y outcome",
      "description": "p95 < 50ms en el fast-path (edge). SC-002 / AC3.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (region, outcome, le) (rate(petai_cdn_refresh_ms_bucket[5m])))",
          "legendFormat": "{{region}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ratio fallback/CDN por región (%)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * sum by (region) (rate(petai_cdn_fallback_origin_total[30m])) / (sum by (region) (rate(petai_cdn_hit_total[30m])) + sum by (region) (rate(petai_cdn_fallback_origin_total[30m])))",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
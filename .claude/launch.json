{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pockai-web-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/scripts/preview.mjs"
      ],
      "port": 4300
    },
    {
      "name": "pockai-desktop-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "pockai-desktop-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "petai-desktop", "run", "demo"],
      "port": 5175
    },
    {
      "name": "pockai-desktop-dev-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "petai-desktop", "exec", "vite", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "pockai-scene-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pockai/scene", "run", "dev"],
      "port": 5180
    },
    {
      "name": "pockai-web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "pockai-web", "exec", "ng", "serve", "--port", "4200"],
      "port": 4200
    },
    {
      "name": "petai-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "petai-backend", "exec", "ts-node", "src/main.ts"],
      "env": { "CORS_ORIGINS": "http://localhost:5173,http://localhost:4200,tauri://localhost" },
      "port": 3000
    }
  ]
}

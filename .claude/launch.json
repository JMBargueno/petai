{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pockai-web-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/scripts/preview.mjs"
      ],
      "port": 4300
    },
    {
      "name": "pockai-desktop-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "pockai-desktop-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "run",
        "demo"
      ],
      "port": 5175
    },
    {
      "name": "pockai-desktop-demo-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "run",
        "demo"
      ],
      "env": {
        "DEMO_PORT": "5176"
      },
      "port": 5176
    },
    {
      "name": "pockai-desktop-demo-alt2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "run",
        "demo"
      ],
      "env": {
        "DEMO_PORT": "5178"
      },
      "port": 5178
    },
    {
      "name": "pockai-minigames-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pockai/minigames",
        "run",
        "dev"
      ],
      "port": 5181
    },
    {
      "name": "pockai-desktop-dev-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-desktop",
        "exec",
        "vite",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "pockai-scene-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pockai/scene",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "pockai-scene-dev-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pockai/scene",
        "exec",
        "vite",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    },
    {
      "name": "pockai-web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "pockai-web",
        "exec",
        "ng",
        "serve",
        "--port",
        "4200"
      ],
      "port": 4200
    },
    {
      "name": "petai-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "petai-backend",
        "exec",
        "ts-node",
        "src/main.ts"
      ],
      "env": {
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:4200,tauri://localhost"
      },
      "port": 3000
    },
    {
      "name": "pockai-sfx-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "sfx:review",
        "--only",
        "cook.hotpot"
      ],
      "port": 5199,
      "url": "http://127.0.0.1:5199"
    },
    {
      "name": "pockai-android-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pockai/android-ui",
        "run",
        "dev"
      ],
      "port": 5183
    },
    {
      "name": "pockai-ios-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pockai/ios-ui",
        "run",
        "dev"
      ],
      "port": 5185
    }
  ]
}

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Databases
DATABASE_URL=postgresql://petai_user:petai_password@localhost:5432/petai_dev?schema=public
REDIS_URL=redis://localhost:6379

# ---- Sync offline (S-07) ----
# Estado de sincronía POR USUARIO en Redis con TTL y topes duros. Si Redis cae, hay un respaldo
# en memoria acotado por usuario. Para apagar el módulo: SYNC_ENABLED=false.
SYNC_STATE_TTL_MS=86400000
SYNC_MAX_DELTAS=2000
SYNC_MAX_SEEN_ACTIONS=1000
SYNC_MAX_ARGS_BYTES=4096
SYNC_MAX_PETS=100
SYNC_ENABLED=true

# Authentication & Security
# Keys should be at least 32 characters long
JWT_ACCESS_SECRET=change-me-super-secret-jwt-access-token-key-32chars
JWT_REFRESH_SECRET=change-me-super-secret-jwt-refresh-token-key-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM master key (64 hex characters = 32 bytes)
AI_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI & LLM Providers
OPENAI_API_KEY=
HERMES_LOCAL_URL=http://127.0.0.1:8642

# SOLO desarrollo/tests: permite baseUrl http o hacia direcciones privadas (desactiva la protección SSRF).
# En producción debe ser false.
AI_ALLOW_INSECURE_URLS=false

# --- Notificaciones con personalidad (feature 007) ---
# Máximo de notificaciones/día POR DEFECTO cuando el usuario no fija su propio `maxPerDay`
# (PATCH /me). Rango 1-10. Si no se define, se usa `balance.notifications.rateLimit.defaultMaxPerDay`.
# NOTIFICATIONS_DEFAULT_MAX_PER_DAY=3

# PRODUCCIÓN: el servidor se niega a arrancar si JWT_ACCESS_SECRET, JWT_REFRESH_SECRET (distintos y de
# al menos 32 caracteres), AI_KEY_ENCRYPTION_KEY o DATABASE_URL conservan los valores de desarrollo de este
# archivo, que son públicos. Genera los tuyos, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Detrás de un proxy/balanceador: número de saltos de confianza para obtener la IP real del cliente.
TRUST_PROXY=0
# Límite de intentos de autenticación (valores por defecto)
# AUTH_LOGIN_MAX_FAILS_PER_ACCOUNT=10
# AUTH_LOGIN_MAX_FAILS_PER_IP=100
# AUTH_LOGIN_MAX_FAILS_PER_ACCOUNT_GLOBAL=50
# AUTH_LOGIN_WINDOW_MINUTES=15
# AUTH_REGISTER_MAX_PER_IP=10
# AUTH_REFRESH_MAX_PER_MINUTE=60
# Límite global: peticiones por minuto por usuario autenticado o, sin sesión, por IP (todas las rutas salvo /health)
# RATE_LIMIT_PER_MINUTE=300

# CORS & Client endpoints
# Orígenes de navegador permitidos (HTTP y WebSocket), separados por comas. Sin esta variable se admiten solo
# Vite (localhost:5173) y el webview de Tauri. Las peticiones sin cabecera Origin (curl, apps nativas) no se ven afectadas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Documentación Swagger (/v1/docs): por defecto solo fuera de producción; true/false lo fuerza en cualquier entorno.
# SWAGGER_ENABLED=false

# --- Observabilidad (OpenTelemetry + Prometheus) ---
# Puerto del servidor de métricas (aislado del API). No se expone al host en producción.
# METRICS_PORT=9464
# Sin OTEL_EXPORTER_OTLP_ENDPOINT el SDK de traces queda desactivado de forma segura y solo
# se expone /metrics por prom-client. En dev apunta a Jaeger (docker-compose.yml).
# OTEL_SERVICE_NAME=petai-backend
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_METRICS_EXPORTER=prometheus

# --- Actualizaciones de la app de escritorio (updater de Tauri) ---
# El repo es privado: el backend lee el último release publicado con este token y hace de proxy.
# Fine-grained PAT con permiso de solo lectura «Contents» sobre el repo. Sin token no se ofrecen updates.
# GITHUB_RELEASES_TOKEN=
# GITHUB_RELEASES_REPO=JMBargueno/petai

# --- Correo (recuperación de contraseña, notificaciones y formulario de contacto) ---
# Sin SMTP_HOST los correos solo se escriben en el log. Producción: mailcow.
# Dos buzones: noreply@ es el de SISTEMA (envía todo: avisos a usuarios y el formulario hacia contact@);
# contact@ solo RECIBE (formulario de contacto y respuestas de los usuarios).
# SMTP_SECURE=true usa TLS implícito (465); false usa STARTTLS (587).
# SMTP_HOST: si es un hostname, nodemailer lo resuelve con su propio DNS (NO respeta
# /etc/hosts del contenedor). Desde un contenedor, el hostname público del host NO
# funciona por el camino normal (firewall: de containers a host solo 22/80/443;
# hairpin bloqueado; el hostname resuelve a IPv6). Opciones buenas:
#   - nombre del contenedor de correo SI este está en una red compartida con el
#     backend (compose: unir el backend a esa red; el cert debe cubrir el nombre
#     o pasar SMTP_TLS_SERVERNAME), o
#   - IP literal del contenedor de correo + SMTP_TLS_SERVERNAME con el nombre
#     público (el cert va para el nombre). En la VPS: postfix de mailcow, IP fija .253:
# SMTP_HOST=172.22.1.253
# SMTP_TLS_SERVERNAME=mail.jmbargueno.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@pockai.world
# SMTP_PASS=
# MAIL_FROM=Pockai <noreply@pockai.world>
# MAIL_REPLY_TO=contact@pockai.world
# CONTACT_TO=contact@pockai.world

# --- Enlaces de los correos ---
# Web pública (enlace de verificación /es/verify-email y logo de la plantilla) y API pública
# (enlace de baja y cabecera List-Unsubscribe de los envíos del panel).
# PUBLIC_WEB_URL=https://pockai.world
# PUBLIC_API_URL=https://game-api.pockai.world

# --- Verificación de correo y envíos desde el panel ---
# true: las cuentas sin verificar reciben 403 EMAIL_NOT_VERIFIED (no pueden usar escritorio ni Android).
# Activar SOLO cuando estén publicadas las versiones de las apps con la pantalla de verificación.
# EMAIL_VERIFICATION_REQUIRED=false
# Validez del código y del enlace (minutos; 24 h por defecto).
# EMAIL_VERIFICATION_TTL_MINUTES=1440
# Firma de los enlaces de baja (opcional; por defecto se deriva de JWT_ACCESS_SECRET).
# MAIL_UNSUBSCRIBE_SECRET=
# Ritmo de la cola de envíos del panel (correos por segundo).
# EMAIL_CAMPAIGN_RATE_PER_SECOND=5

# --- Nickname (@handle) ---
# true: las cuentas sin nickname reciben 403 HANDLE_REQUIRED hasta elegirlo (pantalla "Elige tu nickname").
# Activar SOLO cuando estén publicadas las versiones de escritorio y Android con esa pantalla.
# HANDLE_REQUIRED=false
# Comprobaciones públicas de disponibilidad de nickname por IP y minuto.
# AUTH_HANDLE_CHECK_MAX_PER_MINUTE=60

# --- Solo para docker-compose.prod.yml (despliegue en producción, ver docs/DEPLOY.md) ---
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=petai

# --- Efectos de sonido (solo desarrollo, spec 40) ---
# Key de ElevenLabs para `pnpm sfx:generate`. NO va en las apps ni en el backend: solo genera los
# ficheros de shared/assets/audio en tu máquina o en CI.
# ELEVENLABS_API_KEY=
# Modelo de efectos de sonido (por defecto eleven_text_to_sound_v3, SFX v3).
# La CLI de ElevenLabs (`npx -y @elevenlabs/cli@latest onboard init`) deja la key en .env.local,
# que los scripts también leen.
# ELEVENLABS_SFX_MODEL=

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Databases
DATABASE_URL=postgresql://petai_user:petai_password@localhost:5432/petai_dev?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Keys should be at least 32 characters long
JWT_ACCESS_SECRET=change-me-super-secret-jwt-access-token-key-32chars
JWT_REFRESH_SECRET=change-me-super-secret-jwt-refresh-token-key-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM master key (64 hex characters = 32 bytes)
AI_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI & LLM Providers
OPENAI_API_KEY=
HERMES_LOCAL_URL=http://127.0.0.1:8642

# SOLO desarrollo/tests: permite baseUrl http o hacia direcciones privadas (desactiva la protección SSRF).
# En producción debe ser false.
AI_ALLOW_INSECURE_URLS=false

# PRODUCCIÓN: el servidor se niega a arrancar si JWT_ACCESS_SECRET, JWT_REFRESH_SECRET (distintos y de
# al menos 32 caracteres), AI_KEY_ENCRYPTION_KEY o DATABASE_URL conservan los valores de desarrollo de este
# archivo, que son públicos. Genera los tuyos, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Detrás de un proxy/balanceador: número de saltos de confianza para obtener la IP real del cliente.
TRUST_PROXY=0
# Límite de intentos de autenticación (valores por defecto)
# AUTH_LOGIN_MAX_FAILS_PER_ACCOUNT=10
# AUTH_LOGIN_MAX_FAILS_PER_IP=100
# AUTH_LOGIN_MAX_FAILS_PER_ACCOUNT_GLOBAL=50
# AUTH_LOGIN_WINDOW_MINUTES=15
# AUTH_REGISTER_MAX_PER_IP=10
# AUTH_REFRESH_MAX_PER_MINUTE=60
# Límite global: peticiones por minuto por usuario autenticado o, sin sesión, por IP (todas las rutas salvo /health)
# RATE_LIMIT_PER_MINUTE=300

# CORS & Client endpoints
# Orígenes de navegador permitidos (HTTP y WebSocket), separados por comas. Sin esta variable se admiten solo
# Vite (localhost:5173) y el webview de Tauri. Las peticiones sin cabecera Origin (curl, apps nativas) no se ven afectadas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Documentación Swagger (/v1/docs): por defecto solo fuera de producción; true/false lo fuerza en cualquier entorno.
# SWAGGER_ENABLED=false

# --- Observabilidad (OpenTelemetry + Prometheus) ---
# Puerto del servidor de métricas (aislado del API). No se expone al host en producción.
# METRICS_PORT=9464
# Sin OTEL_EXPORTER_OTLP_ENDPOINT el SDK de traces queda desactivado de forma segura y solo
# se expone /metrics por prom-client. En dev apunta a Jaeger (docker-compose.yml).
# OTEL_SERVICE_NAME=petai-backend
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_METRICS_EXPORTER=prometheus

# --- Solo para docker-compose.prod.yml (despliegue en producción, ver docs/DEPLOY.md) ---
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=petai

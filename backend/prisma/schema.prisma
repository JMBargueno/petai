datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  // Rol de autorización (RBAC). Los permisos de cada rol viven en código: src/modules/authz/permissions.ts
  role         String         @default("user") // superadmin | admin | moderator | user
  displayName  String?
  title       String?        // Título competitivo de la arena (premio de fin de temporada por liga)
  timezone     String         @default("UTC")
  // Coordenadas opt-in para el clima (privacidad): se guardan redondeadas y solo las usa el servidor.
  latitude     Float?
  longitude    Float?
  // Cumpleaños como "YYYY-MM-DD" (para micro-momentos de festividad).
  birthday     String?
  // Preferencias de notificaciones con personalidad (feature 007). `null` = defaults
  // (todas las categorías activas, maxPerDay=3). Objeto: { vitals_critical, interaction,
  // achievement, arena, event, maxPerDay }.
  notificationPrefs Json?
  coins        Int            @default(100)
  gems         Int            @default(5)
  accountXp    Int            @default(0)
  stripeCustomerId String?    @unique
  emailVerifiedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens  RefreshToken[]
  subscriptions  Subscription[]
  deviceLinks    DeviceLink[]
  passwordResetTokens PasswordResetToken[]
  // Invitaciones de registro: códigos creados por este admin y el canje con el que se registró.
  invitesCreated   InviteCode[]       @relation("InviteCreatedBy")
  inviteRedemption InviteRedemption?
  pets           Pet[]
  eggs           Egg[]
  inventory      InventoryItem[]
  pityCounter    PityCounter?
  aiConfig       AiConfig?
  reminders      Reminder[]
  minigames      MinigameSession[]
  pendingActions PendingAction[]
  aiUsage        AiUsage[]
  missions       Mission[]
  chests         Chest[]
  chestPity      ChestPity[]
   achievements   Achievement[]
   // Opt-in de visibilidad pública de logros (feature 008): por defecto false (privacidad por defecto).
   achievementsPublic Boolean @default(false)
  // Feature 011: Temporadas
  seasonPasses     SeasonPass[]
  seasonProgress   SeasonProgress[]
  seasonLeagueSettlements SeasonLeagueSettlement[]
  // Feature 012: Breeding
  breedings        Breeding[]
  // Feature 016: Entrenamiento Elemental
  trainingSessions TrainingSession[]
  // Feature 018: Aventura Narrativa IA
  adventures       Adventure[]
  // Feature 013: Raid
  raidParticipants RaidParticipant[]
  // Feature 014: Tournament
  tournamentEntries TournamentEntry[]
  // Feature 015: Cooking
  cookingSessions  CookingSession[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DeviceLink {
  code        String    @id
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Recuperación de contraseña: código de 6 dígitos de un solo uso, atado a un usuario por email.
// `code` es la PK (espacio 10^6) y `consumedAt` marca el uso; `expiresAt` lo caduca (15 min).
model PasswordResetToken {
  code        String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Ajustes globales de la app (una sola fila, id = 1). Editables desde el panel admin.
model AppSettings {
  id                     Int      @id @default(1)
  // Si está activo, el registro exige un código de invitación válido.
  registrationInviteOnly Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

// Código de invitación para el registro. Se canjea de forma atómica (usedCount < maxUses).
model InviteCode {
  id          String             @id @default(uuid())
  code        String             @unique // XXXX-XXXX, en mayúsculas
  maxUses     Int                @default(1)
  usedCount   Int                @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  note        String?
  createdById String?
  createdBy   User?              @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  redemptions InviteRedemption[]

  @@index([createdAt])
}

// Qué usuario se dio de alta con qué código (cada usuario, como mucho un canje).
model InviteRedemption {
  id           String     @id @default(uuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([inviteCodeId])
}

model Species {
  id             String   @id
  name           String
  description    String
  element        String
  rarity         String
  baseStats      Json
  favoriteFood   String
  spriteKey      String
  defaultPalette Json

  pets           Pet[]
}

model Pattern {
  id          String   @id
  name        String
  description String
  minRarity   String

  pets        Pet[]
}

model Egg {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eggType      String    @default("standard")
  startedAt    DateTime  @default(now())
  hatchesAt    DateTime
  hatchedPetId String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Pet {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesId     String
  species       Species   @relation(fields: [speciesId], references: [id])
  rarity        String
  patternId     String
  pattern       Pattern   @relation(fields: [patternId], references: [id])
  palette       Json
  shiny         Boolean   @default(false)
  visualSeed    Int
  nickname      String
  level         Int       @default(1)
  xp            Int       @default(0)
  stage         String    @default("baby")
  
  // Vital Stats (0-100)
  hunger        Float     @default(100.0)
  happiness     Float     @default(100.0)
  energy        Float     @default(100.0)
  hygiene       Float     @default(100.0)
  health        Float     @default(100.0)
  sick          Boolean   @default(false)
  sleeping      Boolean   @default(false)

  // Combat & RPG Stats
  combatStats   Json
  statPoints    Int       @default(0)
  skills        Json      @default("[]")
  elo           Int       @default(1000)
  strategy      String    @default("balanced")

  // Intelligence & AI
  intelligence  Int       @default(0)
  awakened      Boolean   @default(false)
  personality   Json?
  desktopSkills Json?     @default("{}")
  inHabitat     Boolean   @default(false)

  lastTickAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Feature 028: Welcome Back (Re-engagement) — reactivación tras ausencia
  lastLoginAt         DateTime? // último momento en que el jugador "estuvo presente"
  absenceDiary        Json?     // viñetas SVG/texto generadas durante la ausencia
  recoveryBuffUntil   DateTime? // fin del buff anti-decaimiento (24h)
  welcomeBackTier     String?   // happy | offended | sad | emotional (tramo de la ausencia)
  lastWelcomeBackAt   DateTime? // última vez que se completó la cinemática (anti-spam)

  // Bonding Meter (feature 006): vínculo jugador-pet 0-100, rango y base del decaimiento lazy
  bonding           Float       @default(0)
  bondingTier       String      @default("acquainted")
  lastInteractionAt DateTime    @default(now())
  bondingEvents     BondingEvent[]

  chatMessages  ChatMessage[]
  memories      PetMemory[]
  contextProfile PetContextProfile?
  reminders     Reminder[]
  pendingActions PendingAction[]
  minigames     MinigameSession[]
  battlesAsAttacker Battle[] @relation("AttackerBattles")
  battlesAsDefender Battle[] @relation("DefenderBattles")

  // Feature 010: Habitat
  habitat Habitat?
  // Feature 012: Breeding
  breedingAsParent1 Breeding[] @relation("Parent1")
  breedingAsParent2 Breeding[] @relation("Parent2")
  // Feature 016: Entrenamiento Elemental
  trainingSessions TrainingSession[]
  // Feature 018: Aventura Narrativa IA
  adventures Adventure[]
  // Feature 013: Raid
  raidParticipants RaidParticipant[]
  // Feature 014: Tournament
  tournamentEntries TournamentEntry[]
  // Feature 015: Cooking
  cookingSessions  CookingSession[]

  @@index([userId])
  @@index([speciesId])
  @@index([elo])
}

// Auditoría del Bonding Meter (feature 006): cada cambio puntual del vínculo (incremento por
// interacción o decaimiento por abandono) produce exactamente una fila.
model BondingEvent {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  delta     Float
  reason    String // feed | battle | minigame | chat | clean | sleep | evolve | decay
  value     Float
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

model PityCounter {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sinceSuperRare  Int      @default(0)
  sinceLegendary  Int      @default(0)
}

model Item {
  id          String   @id
  kind        String
  name        String
  description String
  effects     Json
  priceCoins  Int      @default(0)
  priceGems   Int      @default(0)

  inventory   InventoryItem[]
}

model InventoryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  qty       Int      @default(1)

  @@unique([userId, itemId])
}

model MinigameSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId      String
  pet        Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  gameId     String
  seed       Int
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int       @default(0)
  rewarded   Boolean   @default(false)

  @@index([userId])
  @@index([petId])
}

model Battle {
  id             String    @id @default(uuid())
  attackerPetId  String
  attackerPet    Pet       @relation("AttackerBattles", fields: [attackerPetId], references: [id])
  // null cuando el rival es un bot determinista (su instantánea está en el log)
  defenderPetId  String?
  defenderPet    Pet?      @relation("DefenderBattles", fields: [defenderPetId], references: [id])
  seed           Int
  winnerPetId    String?
  log            Json
  eloDelta       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([attackerPetId, createdAt])
  @@index([defenderPetId, createdAt])
}

model AiConfig {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         String    @default("byok") // byok | managed
  provider     String    @default("openai") // openai | hermes | custom | auto
  baseUrl      String?
  model        String?
  encryptedKey String?
  keyIv        String?
  keyTag       String?
  // Feature 019: Multi-Model AI Router
  fallbackProviders  Json?
  routingOverrides   Json?
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  role      String   // user | assistant | system | tool
  content   String
  toolCalls Json?
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

model PetMemory {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  kind      String   // fact | summary | habit
  content   String
  /// Clave estable de los hábitos (habit:coding_time…): se reemplazan por upsert, no se acumulan
  key       String?
  createdAt DateTime @default(now())

  @@unique([petId, key])
  @@index([petId, createdAt])
}

/// Perfil de hábitos de escritorio (una fila por mascota, tamaño fijo). Se alimenta con un
/// resumen diario del escritorio (solo categorías y minutos) y decae con el tiempo.
model PetContextProfile {
  petId        String   @id
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  data         Json
  lastDigestAt DateTime
  updatedAt    DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  text      String
  dueAt     DateTime
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([petId])
}

// Acción propuesta por la IA (function calling) que requiere confirmación explícita del usuario
model PendingAction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  tool      String
  args      Json
  summary   String
  status    String   @default("pending") // pending | confirmed | rejected
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([petId])
}

// Consumo mensual de tokens de IA por usuario (mes UTC "YYYY-MM"), para cuotas y transparencia
model AiUsage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String
  tokens    Int      @default(0)
  requests  Int      @default(0)
  // Feature 019: Multi-Model AI Router
  provider  String?
  costUsd   Float    @default(0)
  cacheHits Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, month])
}

// Misiones diarias/semanales: un objetivo numérico que se incrementa con acciones del jugador
model Mission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String   // "daily" | "weekly"
  type        String   // feed | battle | minigame | chat | clean | sleep | evolve | hatch | level_up | battle_win | hatch_rare
  description String
  target      Int
  current     Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  rewardCoins Int      @default(0)
  rewardGems  Int      @default(0)
  rewardXp    Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, period, periodEnd])
  @@index([userId, completed])
}

// Cofre del usuario: contiene items aleatorios resueltos al abrirlo (drop table data-driven en
// shared/game-data/balance.json → chests). `openedAt` es null hasta que se abre; `drops` guarda
// los drops resueltos (Json) al momento de la apertura. Caduca a los 30 días (job chests:cleanup).
model Chest {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // bronze | silver | gold | diamond | mythic
  source    String // daily_mission | battle | evolution | purchase | event
  openedAt  DateTime?
  drops     Json?
  createdAt DateTime  @default(now())

  @@index([userId, openedAt])
}

// Progreso de pity de un usuario por tipo de cofre (independiente de PityCounter, que gestiona el
// pity de eclosión de pets). `count` = aperturas consecutivas sin drop de `minTier`; se resetea a 0
// cuando cae un drop de tier >= minTier. Único por [userId, tier].
model ChestPity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   String // tipo de cofre: bronze | silver | gold | diamond | mythic
  count  Int    @default(0)

  @@unique([userId, tier])
}

// Logro del usuario (feature 008): un hito único y no repetible definido de forma data-driven en
// shared/game-data/achievements.json. `current` se incrementa con eventos de dominio; al alcanzar
// `target` se fija `unlockedAt` (desbloqueo atómico, una sola vez) y se acredita la recompensa.
// `id` es el id lógico del logro (p. ej. `care_feed_50`); el par (userId, id) es único.
model Achievement {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // id lógico del logro según achievements.json (p. ej. `care_feed_50`, `battle_10_wins`).
  achId       String
  current     Int       @default(0)
  unlockedAt  DateTime?
  claimed     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, achId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 010: Hábitat / Base Personalizable
// ─────────────────────────────────────────────────────────────────────────────

model Habitat {
  id          String         @id @default(uuid())
  petId       String         @unique
  pet         Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  habitatSeed Int
  rooms       String[]       @default(["sala"])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       HabitatItem[]
}

model HabitatItem {
  id          String   @id @default(uuid())
  petId       String
  habitatId   String
  furnitureId String
  roomId      String
  x           Int
  y           Int
  purchasedAt DateTime @default(now())
  habitat     Habitat  @relation(fields: [habitatId], references: [id], onDelete: Cascade)

  @@unique([petId, x, y, roomId])
  @@index([petId, roomId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 011: Temporadas + Pase de Temporada
// ─────────────────────────────────────────────────────────────────────────────

model Season {
  id        String    @id @default(uuid())
  name      String
  theme     String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean   @default(true)

  passes    SeasonPass[]
  progress  SeasonProgress[]
  rewards   SeasonReward[]
  leagueSettlements SeasonLeagueSettlement[]
}

model SeasonPass {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  price       Int
  purchasedAt DateTime @default(now())

  @@unique([userId, seasonId])
}

model SeasonProgress {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  currentTier Int     @default(0)
  totalXp     Int     @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, seasonId])
  @@index([userId, seasonId])
}

model SeasonReward {
  id          String  @id @default(uuid())
  seasonId    String
  season      Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tier        Int
  rewardType  String
  rewardValue String
  isPremium   Boolean @default(false)

  @@unique([seasonId, tier, rewardType, isPremium])
}

// Premio de fin de temporada de la ARENA por liga/ELO (spec-11 leagueSettle).
// Un registro por (usuario, temporada): liga alcanzada (por su mejor pet), título y monedas/gemas repartidos.
model SeasonLeagueSettlement {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  leagueId     String
  title        String?
  gemsAwarded  Int      @default(0)
  coinsAwarded Int      @default(0)
  bestElo      Int      @default(1000)
  settledAt    DateTime @default(now())

  @@unique([userId, seasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 012: Cruzamiento / Breeding
// ─────────────────────────────────────────────────────────────────────────────

model Breeding {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent1Id  String
  parent1    Pet       @relation("Parent1", fields: [parent1Id], references: [id])
  parent2Id  String
  parent2    Pet       @relation("Parent2", fields: [parent2Id], references: [id])
  status     String    @default("in_progress")
  startedAt  DateTime  @default(now())
  completesAt DateTime
  seed       Int

  result     BreedingResult?

  @@index([userId, status])
}

model BreedingResult {
  id             String   @id @default(uuid())
  breedingId     String   @unique
  breeding       Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  offspringId    String
  inheritedGenes Json
  mutations      Json
  createdAt      DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 013: Boss de Raid asíncrono
// ─────────────────────────────────────────────────────────────────────────────

model Raid {
  id          String    @id @default(uuid())
  element     String
  theme       String
  level       Int       @default(50)
  hpGlobal    Int
  hpRemaining Int
  status      String    @default("active")
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  endedAt     DateTime?
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants RaidParticipant[]

  @@index([status, endedAt])
}

model RaidParticipant {
  id          String   @id @default(uuid())
  raidId      String
  raid        Raid     @relation(fields: [raidId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id])
  damageDealt Int      @default(0)
  totalAttacks Int     @default(0)
  lastAttackAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([raidId, userId])
  @@index([raidId, damageDealt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 014: Torneo Knockout semanal
// ─────────────────────────────────────────────────────────────────────────────

model Tournament {
  id              String    @id @default(uuid())
  status          String    @default("entry")
  entryFee        Int       @default(50)
  totalPrizePool  Int       @default(3000)
  entryDeadline   DateTime
  startedAt       DateTime?
  endsAt          DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries TournamentEntry[]
  matches TournamentMatch[]

  @@index([status])
}

model TournamentEntry {
  id             String     @id @default(uuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId          String
  pet            Pet        @relation(fields: [petId], references: [id])
  elo            Int
  placement      Int?
  registeredAt   DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, elo])
}

model TournamentMatch {
  id          String     @id @default(uuid())
  tournamentId String
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round       Int
  slot        Int
  bestOf      Int        @default(2)
  seed1       Int
  seed2       Int
  petAId      String?
  petBId      String?
  winnerId    String?
  status      String     @default("pending")
  log         Json?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@unique([tournamentId, round, slot])
  @@index([tournamentId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 015: Minijuego Cocina
// ─────────────────────────────────────────────────────────────────────────────

model CookingSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet       @relation(fields: [petId], references: [id])
  recipeId        String
  seed            Int
  ingredients     Json
  hotPotPositions Json
  score           Int?
  buffApplied     Boolean   @default(false)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, finishedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 016: Entrenamiento Elemental
// ─────────────────────────────────────────────────────────────────────────────

model TrainingSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId             String
  pet               Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  seed              Int
  floors            Json
  currentFloor      Int       @default(0)
  hearts            Int       @default(3)
  prediction        String?
  predictionCorrect Boolean   @default(false)
  status            String    @default("active")
  buffMultiplier    Float?
  buffExpiresAt     DateTime?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  xpAwarded         Int       @default(0)
  coinsAwarded      Int       @default(0)

  @@index([userId, status])
  @@index([petId, buffExpiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 018: Aventura Narrativa IA
// ─────────────────────────────────────────────────────────────────────────────

model Adventure {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId        String
  pet          Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  seed         Int
  theme        String
  sceneCount   Int       @default(4)
  currentScene Int       @default(0)
  isPremium    Boolean   @default(false)
  retriesLeft  Int       @default(0)
  status       String    @default("active")
  outcome      String?
  score        Float?
  xpAwarded    Int       @default(0)
  coinsAwarded Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  scenes       AdventureScene[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

model AdventureScene {
  id            String   @id @default(uuid())
  adventureId   String
  adventure     Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  order         Int
  text          String
  choices       Json
  chosenOption  Int?
  isFinal       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([adventureId, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 019: Multi-Model AI Router
// ─────────────────────────────────────────────────────────────────────────────

model AiRouterConfig {
  id              String   @id @default(uuid())
  interactionType String
  primary         String
  model           String
  fallbacks       Json
  maxTokens       Int      @default(2048)
  maxCostUsd      Float    @default(0.02)
  enabled         Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@unique([interactionType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 020: Voice AI
// ─────────────────────────────────────────────────────────────────────────────

model VoiceSession {
  id           String    @id @default(uuid())
  userId       String
  petId        String
  speciesId    String
  mood         String    @default("happy")
  language     String    @default("es")
  status       String    @default("active")
  sttLatencyMs Int?
  llmTokens    Int?
  ttsTotalMs   Int?
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 021: Multi-Device Presence + Co-op
// ─────────────────────────────────────────────────────────────────────────────

model DevicePresence {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String
  platform      String
  lastHeartbeat DateTime  @default(now())
  status        String    @default("online")
  createdAt     DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId, status])
}

model CoopFriendship {
  id        String    @id @default(uuid())
  ownerId   String
  visitorId String
  status    String    @default("pending") // pending | accepted | revoked
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([ownerId, visitorId])
  @@index([ownerId, status])
}

model CoopVisit {
  id          String   @id @default(uuid())
  visitorId   String
  ownerId     String
  petId       String
  action      String   // feed | play | clean
  xpGained    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([visitorId, petId, createdAt])
  @@index([petId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clanes + Visita en vivo del habitat
// (patrón CoopFriendship: ids String planos, SIN relación a `User`)
// ─────────────────────────────────────────────────────────────────────────────

model Clan {
  id          String            @id @default(uuid())
  name        String
  tag         String
  description String?
  leaderId    String
  xp          Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     ClanMembership[]
  messages    ClanMessage[]
  goals       ClanGoal[]

  @@unique([tag])
  @@index([leaderId])
}

model ClanMembership {
  id       String   @id @default(uuid())
  clanId   String
  userId   String
  role     String   @default("member") // creator (Forjador) | admin (Guardián) | moderator (Vigía) | member (Hermano)
  joinedAt DateTime @default(now())
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([userId]) // un clan activo por usuario
  @@index([clanId])
}

// Chat del clan: mensajes internos (userId String plano, sin relación a `User`).
model ClanMessage {
  id        String   @id @default(uuid())
  clanId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
}

// Metas / objetivos compartidos del clan con progreso y métrica (xp | visits | generic).
model ClanGoal {
  id          String    @id @default(uuid())
  clanId      String
  title       String
  description String?
  metric      String    @default("generic")
  target      Int
  progress    Int       @default(0)
  status      String    @default("active") // active | completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  clan        Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId, status])
}

// Visita "en vivo": el pet del visitante aparece en el habitat del dueño en tiempo real.
model HabitatVisit {
  id        String    @id @default(uuid())
  visitorId String
  ownerId   String
  petId     String
  status    String    @default("active") // active | ended
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId, status])
  @@index([visitorId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 022: Offline-First CRDT Sync
// ─────────────────────────────────────────────────────────────────────────────

model SyncVersion {
  id        String   @id @default(uuid())
  userId    String
  version   Int
  state     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, version])
  @@index([userId, version])
}

model SyncAction {
  id        String   @id
  userId    String
  petId     String
  type      String
  args      Json
  status    String   @default("pending") // pending | applied | rejected
  reason    String?
  timestamp DateTime @default(now())

  @@index([userId, status])
  @@index([userId, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 023: Combat Spectator
// ─────────────────────────────────────────────────────────────────────────────

model SpectatorSession {
  id            String   @id @default(uuid())
  battleId      String
  userId        String
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  lastRoundSeen Int      @default(0)
  isActive      Boolean  @default(true)

  @@index([battleId, isActive])
  @@index([userId, joinedAt])
}

model Highlight {
  id            String   @id @default(uuid())
  battleId      String
  type          String   // critical | comeback | long_battle | multiple
  rating        Float    @default(0)
  replayData    Json
  totalRounds   Int
  criticalCount Int      @default(0)
  hasComeback   Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([battleId])
  @@index([rating, createdAt])
  @@index([expiresAt])
}


// ─────────────────────────────────────────────────────────────────────────────
// Feature 024: Modding API + Workshop
// ─────────────────────────────────────────────────────────────────────────────

model Mod {
  id          String    @id @default(uuid())
  creatorId   String
  type        String    // species | furniture | minigame
  name        String
  description String
  element     String?
  rarity      String?
  data        Json
  spriteUrl   String?
  minigameUrl String?
  status      String    @default("published") // published | hidden | deleted
  downloads   Int       @default(0)
  avgRating   Float     @default(0)
  ratingCount Int       @default(0)
  reportCount Int       @default(0)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ratings      ModRating[]
  reports      ModReport[]
  modDownloads ModDownload[]

  @@index([status, type])
  @@index([element, rarity])
  @@index([creatorId])
}

model ModRating {
  id        String   @id @default(uuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId    String
  stars     Int
  rating    String?
  createdAt DateTime @default(now())

  @@unique([modId, userId])
  @@index([modId])
}

model ModReport {
  id        String   @id @default(uuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId    String
  reason    String
  details   String?
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([modId])
}

model ModDownload {
  id        String   @id @default(uuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId    String
  petId     String?
  createdAt DateTime @default(now())

  @@unique([modId, userId, petId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 025: Public API + Webhooks
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyHash    String    @unique // SHA-256 del key (nunca se guarda el plaintext)
  scopes     Json
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Webhook {
  id              String    @id @default(uuid())
  userId          String
  url             String
  secret          String
  events          Json
  active          Boolean   @default(true)
  lastDeliveryAt  DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([userId, active])
}

model WebhookDelivery {
  id         String    @id @default(uuid())
  webhookId  String
  webhook    Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  status     String    @default("pending") // pending | delivered | failed
  statusCode Int?
  attempts   Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())

  @@index([webhookId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 026: Security — Zero-Trust + E2E
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  event       String   // login | refresh | ip_change | key_created | key_revoked | account_deleted | role_change | balance_adjust | invite_create | invite_revoke | registration_settings_change
  ip          String?
  userAgent   String?
  fingerprint String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([fingerprint])
}

model E2eKeyPair {
  id         String    @id @default(uuid())
  userId     String
  publicKey  String   // PEM P-256
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 029: Pet Buddies — interacciones entre 2+ pets
// ─────────────────────────────────────────────────────────────────────────────

model BuddyPair {
  id         String   @id @default(uuid())
  userId     String
  petAId     String
  petBId     String
  separated  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, petAId, petBId])
  @@index([userId])
}

model BuddyInteraction {
  id        String   @id @default(uuid())
  userId    String
  petAId    String
  petBId    String
  type      String   // chase | sleep_together | play_fight | eat_together | idle_chat | watch_together
  duration  Int      @default(4)
  effects   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([petAId, createdAt])
  @@index([petBId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 030: Rituals — hábitos y rituales
// ─────────────────────────────────────────────────────────────────────────────

model Ritual {
  id        String   @id @default(uuid())
  userId    String
  petId     String
  type      String   // feed | battle | minigame | chat | clean
  cadence   String   @default("daily") // daily | weekly
  hour      Int
  minute    Int      @default(0)
  dayOfWeek Int?     // 0-6 (lunes-domingo), null = diario
  status    String   @default("candidate") // candidate | active | paused | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([petId])
}

model RitualProgress {
  id               String    @id @default(uuid())
  ritualId         String
  userId           String
  petId            String
  streak           Int       @default(0)
  totalCompletions Int       @default(0)
  missCount        Int       @default(0)
  lastCompletedAt  DateTime?
  lastAdaptCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([ritualId])
  @@index([userId])
  @@index([petId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 031: Mood Theater — micro-narrativas / momentos
// ─────────────────────────────────────────────────────────────────────────────

model MoodMoment {
  id             String    @id @default(uuid())
  userId         String
  petId          String
  act            String   // dance | sing | cry | smoke | glow | yawn | stretch
  trigger        String   // favorite_food | happy_well_fed | sad_sick | battle_loss | level_up | low_energy | wake_up
  mood           String?
  duration       Int      @default(5)
  captured       Boolean  @default(false)
  stickerKey     String?
  capturedAt     DateTime?
  sharedToFeed   Boolean  @default(false)
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([petId, createdAt])
  @@index([sharedToFeed, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 032: Accessibility & Inclusion
// ─────────────────────────────────────────────────────────────────────────────

model AccessibilityPrefs {
  id             String   @id @default(uuid())
  userId         String   @unique
  highContrast   Boolean  @default(false)
  reduceMotion   Boolean  @default(false)
  captions       Boolean  @default(true)
  simpleMode     Boolean  @default(false)
  reduceHaptics  Boolean  @default(false)
  fontSizeScale  Int      @default(100)
  colorblindMode String?  // null | protanopia | deuteranopia | tritanopia
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 033: Gifting & Care Packages
// ─────────────────────────────────────────────────────────────────────────────

model Gift {
  id            String    @id @default(uuid())
  senderId      String
  receiverId    String
  petId         String
  itemId        String
  qty           Int       @default(1)
  note          String?
  thankYouNote  String?
  status        String    @default("pending") // pending | accepted | rejected | expired
  sentAt        DateTime  @default(now())
  expiresAt     DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([senderId, sentAt])
  @@index([receiverId, sentAt])
}

model CarePackage {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  petId      String
  foodItemId String
  medicineItemId String
  toyItemId  String
  coins      Int       @default(50)
  note       String?
  status     String    @default("applied")
  appliedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
}

model GroupSession {
  id                 String    @id @default(uuid())
  code               String    @unique
  hostId             String
  maxPlayers         Int       @default(4)
  status             String    @default("active") // active | complete | expired
  participants       Json      @default("[]")
  generatedItemId    String?
  rewardsDistributed Boolean   @default(false)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  completedAt        DateTime?

  @@index([hostId])
  @@index([status, expiresAt])
}

// Spec-34: IA Gestionada (Pockai AI) + Suscripción Pro
model Subscription {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source            String    // stripe | google_play
  externalId        String    // sub_xxx (Stripe) | purchaseToken (Play)
  productId         String    // price_xxx | pockai_pro_monthly
  plan              String    @default("pro")
  status            String    // active | trialing | past_due | canceled | expired | revoked
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean   @default(false)
  graceUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([userId, status])
}

/// Idempotencia y auditoría de eventos de pago (webhooks Stripe, RTDN Play).
model BillingEvent {
  id          String   @id @default(uuid())
  source      String   // stripe | google_play
  eventId     String   // evt_xxx | messageId de Pub/Sub
  type        String
  userId      String?
  payloadHash String   // SHA-256; nunca se guarda el payload con datos de tarjeta
  processedAt DateTime @default(now())

  @@unique([source, eventId])
}

/// Configuración versionada de precios y límites de IA/facturación (solo superadmin).
model BillingConfig {
  id             String   @id @default(uuid())
  version        Int      @unique
  active         Boolean  @default(false)
  data           Json     // validado con billing-config.schema.ts
  stripePriceIds Json?    // { "usd": "price_…", "eur": "price_…" }
  createdById    String
  note           String?  // motivo del cambio
  createdAt      DateTime @default(now())

  @@index([active])
}


{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@pockai/minigames/logic$": "<rootDir>/../../shared/minigames/src/logic.ts",
    "^@pockai/mind/node$": "<rootDir>/../../shared/mind/src/index.ts"
  }
}

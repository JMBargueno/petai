{
  "name": "@pockai/android-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI de Pockai para Android (Tauri). Es el shell compartido (@pockai/mobile) con la plataforma, los estilos y la configuración de Android: aquí no hay lógica ni pantallas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@pockai/mobile": "workspace:*",
    "@pockai/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}

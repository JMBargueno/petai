{
  "name": "@pockai/android-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI de Pockai para Android (Tauri). Solo presentación: lo que muestra sale del estado del núcleo y lo que hace se lo pide al núcleo con acciones tipadas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@pockai/audio": "workspace:*",
    "@pockai/client": "workspace:*",
    "@pockai/minigames": "workspace:*",
    "@pockai/ui": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}

{
  "name": "@pockai/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de Pockai compartida por Android e iOS (Tauri): el shell con su navegación, el reflejo del núcleo y los contenedores de pantalla. Solo presentación sobre el núcleo: lo que muestra sale de su estado y lo que hace se lo pide con acciones tipadas. Cada app (apps/android, apps/ios) solo fija su plataforma y sus estilos.",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles.ts",
    "./app.css": "./styles/app.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@pockai/audio": "workspace:*",
    "@pockai/client": "workspace:*",
    "@pockai/minigames": "workspace:*",
    "@pockai/ui": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.8.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.13.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}

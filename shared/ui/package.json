{
  "name": "@pockai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca de componentes Svelte de Pockai, solo presentacionales: tokens de diseño, primitivas (botón, tarjeta, modal…) y piezas de interfaz que comparten las UIs de escritorio, Android e iOS. No conoce el núcleo ni el backend.",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./styles/tokens.css",
    "./base.css": "./styles/base.css",
    "./kit.css": "./styles/kit.css",
    "./fonts.css": "./styles/fonts.css",
    "./maps": "./src/maps.ts",
    "./profile-format": "./src/profile-format.ts",
    "./badge-icons": "./src/badge-icons.ts",
    "./social/*": "./src/social/*.ts",
    "./social": "./src/social/index.ts",
    "./handle": "./src/handle.ts",
    "./chatScroll": "./src/chatScroll.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@pockai/minigames": "workspace:*",
    "@pockai/scene": "workspace:*",
    "lucide-svelte": "^0.475.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

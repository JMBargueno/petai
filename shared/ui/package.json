{
  "name": "@pockai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca de componentes Svelte de Pockai, solo presentacionales: tokens de diseño, primitivas (botón, tarjeta, modal…) y piezas de interfaz que comparten las UIs de escritorio, Android e iOS. No conoce el núcleo ni el backend.",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./styles/tokens.css",
    "./base.css": "./styles/base.css",
    "./kit.css": "./styles/kit.css",
    "./platform.css": "./styles/platform.css",
    "./themes.css": "./styles/themes.css",
    "./scene.css": "./styles/scene.css",
    "./fonts.css": "./styles/fonts.css",
    "./maps": "./src/maps.ts",
    "./profile-format": "./src/profile-format.ts",
    "./badge-icons": "./src/badge-icons.ts",
    "./social/*": "./src/social/*.ts",
    "./social": "./src/social/index.ts",
    "./handle": "./src/handle.ts",
    "./chatScroll": "./src/chatScroll.ts",
    "./mind": "./src/mind.ts",
    "./mindTypes": "./src/mindTypes.ts",
    "./talk": "./src/talk.ts",
    "./learned": "./src/learned.ts",
    "./chatText": "./src/chatText.ts",
    "./ambience2d": "./src/ambience2d.ts",
    "./rewards": "./src/rewards.ts",
    "./initiative": "./src/initiative.ts",
    "./platform": "./src/platform.ts",
    "./appearance": "./src/appearance.ts",
    "./themes": "./src/themes/index.ts",
    "./gallery": "./src/KitGallery.svelte"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@pockai/mind": "workspace:*",
    "@pockai/audio": "workspace:*",
    "@pockai/minigames": "workspace:*",
    "@pockai/scene": "workspace:*",
    "lucide-svelte": "^0.475.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

          { "max": 39, "keyword": "timid", "label": "Tímido", "prompt": "Eres tímido ante lo desconocido, aunque te esfuerzas.", "self": "Lo desconocido me impone, aunque me esfuerzo." },
          { "max": 59, "keyword": "steady", "label": "Sereno", "prompt": "Mantienes la calma ante los retos sin buscarlos.", "self": "Mantengo la calma ante los retos sin buscarlos." },
          { "max": 79, "keyword": "brave", "label": "Valiente", "prompt": "Eres valiente: afrontas los retos y animas a tu entrenador a hacerlo.", "self": "Afronto los retos y animo a mi entrenador a hacerlo." },
          { "max": 100, "keyword": "daring", "label": "Temerario", "prompt": "Eres temerario: te lanzas a todo sin pensarlo dos veces.", "self": "Me lanzo a todo sin pensarlo dos veces." }

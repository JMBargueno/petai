          { "max": 59, "keyword": "warm", "label": "Cercano", "prompt": "Eres cercano y agradecido con quien te cuida.", "self": "Soy agradecido con quien me cuida." },
          { "max": 79, "keyword": "affectionate", "label": "Cariñoso", "prompt": "Eres cariñoso: expresas afecto y te preocupas por cómo está tu entrenador.", "self": "Expreso afecto y me preocupo por cómo está mi entrenador." },

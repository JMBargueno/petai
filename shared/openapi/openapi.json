  "info": {
    "title": "PetAI API",
    "description": "API autoritativa para el ecosistema PetAI (tamagotchi virtual inteligente)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jugador@petai.local",
            "description": "Correo electrónico del usuario"
          },
          "password": {
            "type": "string",
            "example": "ContrasenaSegura123!",
            "description": "Contraseña del usuario (mínimo 8 caracteres)"
          },
          "displayName": {
            "type": "string",
            "example": "EntrenadorPet",
            "description": "Nombre mostrado del jugador"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "type": "object"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jugador@petai.local",
            "description": "Correo electrónico del usuario"
          },
          "password": {
            "type": "string",
            "example": "ContrasenaSegura123!",
            "description": "Contraseña del usuario"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Token de refresco rotativo"
          }
        },
        "required": [
          "refreshToken"
        ]
      }
    }
  }

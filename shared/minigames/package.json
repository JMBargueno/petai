{
  "name": "@pockai/minigames",
  "version": "0.2.0",
  "private": true,
  "description": "Minijuegos compartidos de Pockai: lógica determinista, vistas DOM y protocolo para incrustarlos en escritorio, Android e iOS. El backend usa solo la lógica para repetir y validar partidas.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./logic": {
      "require": {
        "types": "./dist/node/logic.d.ts",
        "default": "./dist/node/logic.js"
      },
      "default": "./src/logic.ts"
    }
  },
  "typesVersions": {
    "*": {
      "logic": [
        "dist/node/logic.d.ts"
      ]
    }
  },
  "scripts": {
    "postinstall": "tsc -p tsconfig.node.json && node scripts/mark-cjs.mjs",
    "build:node": "tsc -p tsconfig.node.json && node scripts/mark-cjs.mjs",
    "dev": "vite",
    "build:embed": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@pockai/scene": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
